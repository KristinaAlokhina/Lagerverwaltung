<Window x:Class="Lagerverwaltung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lagerverwaltung"
        Title="Lagerverwaltungssystem v1.0 (IHK Portfolio)" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Überschrift -->
        <TextBlock Text="Lagerbestand-Übersicht" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>

        <!-- Datenbanktabelle -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  Background="White" BorderBrush="#BDC3C7" RowHeight="28" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Artikelnummer" Binding="{Binding ArticleNumber}" Width="120"/>
                <DataGridTextColumn Header="Artikelbezeichnung" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Lagerbestand (Stk.)" Binding="{Binding Stock}" Width="130"/>
                <DataGridTextColumn Header="Preis (€)" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Aktionen -->
        <GroupBox Grid.Row="2" Header="Artikelverwaltung (Aktionen)" Margin="0,15,0,0" Padding="10" FontSize="13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Artikelname:"/>
                        <TextBox Width="180" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Artikelnummer:"/>
                        <TextBox Width="120" Text="{Binding NewArticleNumber, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Bestand (Stk):"/>
                        <TextBox Width="80" Text="{Binding NewStock, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Preis (€):"/>
                        <TextBox Width="80" Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}" Height="25" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Content="Hinzufügen" Command="{Binding AddCommand}" Width="100" Height="25" Margin="0,18,0,0" 
                            Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Speichern" Command="{Binding UpdateStockCommand}" Width="100" Height="25" Margin="0,0,10,0"
                            Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="Löschen" Command="{Binding DeleteCommand}" Width="100" Height="25"
                            Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
